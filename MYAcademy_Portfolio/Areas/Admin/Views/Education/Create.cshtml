@model MYAcademy_Portfolio.Entities.Education

@{
    ViewData["Title"] = "Yeni Eğitim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@section Styles {
    <style>
        .education-form {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
            overflow: hidden;
        }

        .education-header {
            padding: 26px 30px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .education-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: #F0EDFF;
            color: #8276D9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .education-body {
            padding: 30px;
        }

        .section-heading {
            font-size: .92rem;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 20px;
        }

        .form-label {
            font-size: .82rem;
            font-weight: 600;
            color: #424A60;
            margin-bottom: 8px;
        }

            .form-label span {
                color: #C0342B;
            }

        .field-wrapper {
            position: relative;
        }

            .field-wrapper > i {
                position: absolute;
                left: 14px;
                top: 13px;
                color: #9299AD;
                pointer-events: none;
            }

            .field-wrapper .form-control {
                padding: 11px 14px 11px 42px;
                border: 1px solid #E1E4ED;
                border-radius: 11px;
                font-size: .87rem;
                background: #fff;
                transition: .2s ease;
            }

                .field-wrapper .form-control:focus {
                    border-color: #8276D9;
                    box-shadow: 0 0 0 3px rgba(130,118,217,.10);
                }

            .field-wrapper textarea.form-control {
                min-height: 145px;
                resize: vertical;
            }

        .textarea-wrapper > i {
            top: 15px;
        }

        .status-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border: 1px solid #E1E4ED;
            border-radius: 11px;
            min-height: 67px;
        }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.3em;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: #8276D9;
            border-color: #8276D9;
        }

        .form-card-footer {
            padding: 20px 30px;
            background: #FAFBFE;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .btn-accent {
            background: #8276D9;
            border: 1px solid #8276D9;
            color: #fff;
            border-radius: 11px;
            padding: 10px 22px;
            font-size: .87rem;
            font-weight: 600;
        }

            .btn-accent:hover {
                background: #7063C7;
                color: #fff;
            }

        .btn-soft {
            background: #fff;
            border: 1px solid #E1E4ED;
            color: #424A60;
            border-radius: 11px;
            padding: 10px 18px;
            font-size: .87rem;
        }

            .btn-soft:hover {
                background: #F5F3FF;
                color: #8276D9;
            }

        .validation-message {
            font-size: .78rem;
            color: #C0342B;
        }

        @@media(max - width:768px) {
            .education-body {
                padding: 20px;
            }

            .education-header {
                padding: 20px;
            }

            .form-card-footer {
                padding: 18px 20px;
            }
        }
    </style>
}

<div class="education-form">

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div class="education-header">

            <div class="education-icon">
                <i class="bi bi-mortarboard"></i>
            </div>

            <div>
               
                <small class="text-secondary">
                    Eğitim geçmişinize yeni bir kayıt ekleyin.
                </small>
            </div>

        </div>

        <div class="education-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger py-2">
            </div>

            <div class="row g-4">

                <div class="col-12">
                    <div class="section-heading">
                        <i class="bi bi-book me-2"
                           style="color:#8276D9"></i>
                        Eğitim Bilgileri
                    </div>
                </div>

                <div class="col-md-6">

                    <label asp-for="Title" class="form-label">
                        Okul / Kurum Adı
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-building"></i>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Örn: Niğde Üniversitesi" />
                    </div>

                    <span asp-validation-for="Title"
                          class="validation-message"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="SubTitle" class="form-label">
                        Bölüm / Program
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-journal-bookmark"></i>

                        <input asp-for="SubTitle"
                               class="form-control"
                               placeholder="Örn: Bilgisayar Programcılığı" />
                    </div>

                    <span asp-validation-for="SubTitle"
                          class="validation-message"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Duration" class="form-label">
                        Eğitim Tarihi / Süresi
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-calendar3"></i>

                        <input asp-for="Duration"
                               class="form-control"
                               placeholder="Örn: 2022 - 2024" />
                    </div>

                    <span asp-validation-for="Duration"
                          class="validation-message"></span>

                </div>

                <div class="col-md-6">

                    <label class="form-label">
                        Eğitim Durumu
                    </label>

                    <div class="status-box">

                        <div>
                            <div class="fw-semibold"
                                 style="font-size:.85rem">
                                Aktif olarak göster
                            </div>

                            <small class="text-secondary">
                                Eğitim kaydının portfolyoda görünmesini sağlar.
                            </small>
                        </div>

                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />
                        </div>

                    </div>

                </div>

                <div class="col-12">

                    <label asp-for="Description" class="form-label">
                        Eğitim Açıklaması
                    </label>

                    <div class="field-wrapper textarea-wrapper">

                        <i class="bi bi-card-text"></i>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Eğitim sürecinizi, kazandığınız becerileri ve öne çıkan çalışmalarınızı açıklayın..."></textarea>

                    </div>

                    <span asp-validation-for="Description"
                          class="validation-message"></span>

                </div>

            </div>

        </div>

        <div class="form-card-footer">

            <a asp-action="Index"
               class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i>
                Vazgeç
            </a>

            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check2-circle me-1"></i>
                Eğitimi Kaydet
            </button>

        </div>

    </form>

</div>
