@model MYAcademy_Portfolio.Entities.Education

@{
    ViewData["Title"] = "Eğitim Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <h2 class="mb-4">Eğitim Bilgilerini Düzenle</h2>

    <form asp-action="Edit" asp-route-id="@Model.EducationId" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">Okul / Kurum Adı</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SubTitle" class="form-label">Bölüm / Program</label>
            <input asp-for="SubTitle" class="form-control" />
            <span asp-validation-for="SubTitle" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Duration" class="form-label">Tarih / Süre</label>
            <input asp-for="Duration" class="form-control" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Aktif olarak göster</label>
        </div>

        <button type="submit" class="btn btn-primary">
            Değişiklikleri Kaydet
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Vazgeç
        </a>

    </form>
</div>
