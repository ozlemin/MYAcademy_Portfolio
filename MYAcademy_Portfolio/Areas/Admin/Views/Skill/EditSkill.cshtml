@model MYAcademy_Portfolio.Entities.Skill

@{
    ViewData["Title"] = "Yetenek Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@section Styles {
    <style>
        .skill-edit-wrapper {
            max-width: 1250px;
            margin: 0 auto;
        }

        .skill-header {
            margin-bottom: 28px;
        }

            .skill-header h3 {
                font-size: 1.5rem;
                font-weight: 750;
                color: #252b48;
                margin-bottom: 7px;
            }

            .skill-header p {
                color: #8b90a5;
                font-size: .9rem;
                margin: 0;
            }

        .skill-breadcrumb {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #a0a3b3;
            font-size: .8rem;
            margin-bottom: 12px;
        }

            .skill-breadcrumb span:last-child {
                color: #8276d9;
                font-weight: 600;
            }

        .skill-card {
            background: #fff;
            border: 1px solid #ececf3;
            border-radius: 18px;
            box-shadow: 0 5px 25px rgba(35, 40, 75, .045);
            overflow: hidden;
        }

        .skill-card-header {
            padding: 23px 28px;
            border-bottom: 1px solid #f0f0f5;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .skill-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            background: #f0edff;
            color: #8276d9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .skill-card-header h5 {
            font-size: 1rem;
            font-weight: 700;
            color: #303550;
            margin: 0 0 4px;
        }

        .skill-card-header small {
            color: #969aae;
            font-size: .8rem;
        }

        .skill-card-body {
            padding: 30px;
        }

        .field-group {
            margin-bottom: 24px;
        }

        .form-label {
            font-size: .87rem;
            font-weight: 650;
            color: #414761;
            margin-bottom: 9px;
        }

        .form-control {
            min-height: 46px;
            border: 1px solid #e5e6ef;
            border-radius: 10px;
            padding: 11px 14px;
            font-size: .9rem;
            color: #353a55;
            transition: all .2s ease;
        }

            .form-control:focus {
                border-color: #8276d9;
                box-shadow: 0 0 0 3px rgba(130, 118, 217, .12);
            }

        .percentage-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            font-size: .8rem;
            color: #9296aa;
        }

            .percentage-info strong {
                color: #8276d9;
                font-size: .95rem;
            }

        .percentage-track {
            height: 7px;
            background: #efedf8;
            border-radius: 20px;
            overflow: hidden;
            margin-top: 10px;
        }

        .percentage-fill {
            height: 100%;
            background: linear-gradient(90deg, #8276d9, #a69be9);
            border-radius: 20px;
            transition: width .3s ease;
        }

        .status-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8f7ff;
            border: 1px solid #e9e6ff;
            border-radius: 12px;
            padding: 17px 19px;
            min-height: 75px;
        }

            .status-box strong {
                display: block;
                font-size: .9rem;
                color: #343955;
                margin-bottom: 4px;
            }

            .status-box small {
                color: #9296aa;
                font-size: .78rem;
            }

        .form-check-input {
            width: 2.6em;
            height: 1.35em;
            cursor: pointer;
        }

            .form-check-input:checked {
                background-color: #8276d9;
                border-color: #8276d9;
            }

        .skill-footer {
            padding: 20px 30px;
            border-top: 1px solid #f0f0f5;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-save {
            background: #8276d9;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 11px 23px;
            font-size: .88rem;
            font-weight: 650;
            transition: .2s;
        }

            .btn-save:hover {
                background: #7063c5;
                color: white;
                transform: translateY(-1px);
            }

        .btn-cancel {
            background: #f3f3f7;
            color: #62677d;
            border: 1px solid #e9e9ef;
            border-radius: 10px;
            padding: 11px 20px;
            font-size: .88rem;
            font-weight: 600;
            text-decoration: none;
            transition: .2s;
        }

            .btn-cancel:hover {
                background: #eaeaf1;
                color: #343955;
            }

        @@media(max - width: 576px)

        {
            .skill-card-body {
                padding: 20px;
            }

            .skill-card-header {
                padding: 20px;
            }

            .skill-footer {
                padding: 18px 20px;
            }

                .skill-footer button,
                .skill-footer a {
                    flex: 1;
                    text-align: center;
                }
        }
    </style>
}

<div class="container-fluid skill-edit-wrapper">



    </div>

    <div class="skill-card">

        <div class="skill-card-header">

            <div class="skill-icon">
                <i class="fas fa-code"></i>
            </div>

            <div>
                <h5>Yetenek Detayları</h5>
                <small>Mevcut yetenek bilgilerini düzenle</small>
            </div>

        </div>

        <form asp-action="EditSkill"
              asp-route-id="@Model.SkillId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="SkillId" />

            <div class="skill-card-body">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 field-group">

                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-laptop-code me-1 text-secondary"></i>
                            Yetenek Adı
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Örn: C#, ASP.NET Core, SQL" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>

                    </div>

                    <div class="col-md-6 field-group">

                        <label asp-for="Category" class="form-label">
                            <i class="fas fa-layer-group me-1 text-secondary"></i>
                            Yetenek Kategorisi
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="Örn: Backend, Frontend, Database" />

                        <span asp-validation-for="Category"
                              class="text-danger small"></span>

                    </div>

                    <div class="col-12 field-group">

                        <label asp-for="Percentage" class="form-label">
                            <i class="fas fa-chart-line me-1 text-secondary"></i>
                            Yetenek Seviyesi (%)
                        </label>

                        <input asp-for="Percentage"
                               type="number"
                               min="1"
                               max="100"
                               class="form-control"
                               id="percentageInput" />

                        <span asp-validation-for="Percentage"
                              class="text-danger small"></span>

                        <div class="percentage-info">
                            <span>Uzmanlık seviyesi</span>
                            <strong id="percentageValue">@Model.Percentage%</strong>
                        </div>

                        <div class="percentage-track">
                            <div class="percentage-fill"
                                 id="percentageBar"
                                 style="width: @(Math.Clamp(Model.Percentage, 0, 100))%">
                            </div>
                        </div>

                    </div>

                    <div class="col-12">

                        <label class="form-label">Görünürlük Ayarı</label>

                        <div class="status-box">

                            <div>
                                <strong>Portfolyoda Göster</strong>
                                <small>
                                    Aktif olduğunda bu yetenek ziyaretçiler tarafından görüntülenebilir.
                                </small>
                            </div>

                            <div class="form-check form-switch m-0">
                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       type="checkbox"
                                       role="switch" />
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <div class="skill-footer">

                <a asp-action="SkillList" class="btn-cancel">
                    <i class="fas fa-arrow-left me-1"></i>
                    Vazgeç
                </a>

                <button type="submit" class="btn-save">
                    <i class="fas fa-save me-2"></i>
                    Değişiklikleri Kaydet
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <script>
        const percentageInput = document.getElementById("percentageInput");
        const percentageValue = document.getElementById("percentageValue");
        const percentageBar = document.getElementById("percentageBar");

        percentageInput.addEventListener("input", function () {
            let value = Math.min(100, Math.max(0, Number(this.value) || 0));

            percentageValue.textContent = value + "%";
            percentageBar.style.width = value + "%";
        });
    </script>
}
