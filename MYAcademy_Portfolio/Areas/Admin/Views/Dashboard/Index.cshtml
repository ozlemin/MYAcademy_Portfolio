@model MYAcademy_Portfolio.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int totalMsg = Model?.TotalMessageCount ?? 0;
    int readMsg = Model?.ReadMessageCount ?? 0;
    int unreadMsg = Model?.UnreadMessageCount ?? 0;
    int readPercent = totalMsg > 0 ? (int)Math.Round(readMsg * 100.0 / totalMsg) : 0;
    int unreadPercent = totalMsg > 0 ? 100 - readPercent : 0;
}

<style>
    .dash {
        font-family: 'Inter', sans-serif;
        color: #26304b;
        padding: 8px 0 30px;
    }

    /* ÜST KARŞILAMA ALANI */
    .dash-welcome {
        position: relative;
        overflow: hidden;
        padding: 30px;
        margin-bottom: 26px;
        border-radius: 18px;
        background: linear-gradient(120deg, #343B5C 0%, #454D78 65%, #665FA1 100%);
        color: #fff;
        box-shadow: 0 10px 30px rgba(52, 59, 92, .15);
    }

        .dash-welcome::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: 8%;
            top: -125px;
            border-radius: 50%;
            border: 35px solid rgba(255,255,255,.06);
        }

        .dash-welcome::before {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            right: -35px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

    .welcome-content {
        position: relative;
        z-index: 1;
    }

    .welcome-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(255,255,255,.13);
        color: #e5e3ff;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 13px;
    }

    .dash-welcome h2 {
        font-size: 25px;
        font-weight: 750;
        margin-bottom: 8px;
        color: #fff;
    }

    .dash-welcome p {
        font-size: 13px;
        color: #d7d9eb;
        margin: 0;
    }

    .welcome-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 22px;
    }

    .welcome-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

    .welcome-btn-primary {
        background: #fff;
        color: #343B5C;
    }

        .welcome-btn-primary:hover {
            background: #eeeaff;
            color: #343B5C;
            transform: translateY(-2px);
        }

    .welcome-btn-outline {
        border: 1px solid rgba(255,255,255,.35);
        color: #fff;
        background: rgba(255,255,255,.08);
    }

        .welcome-btn-outline:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    /* GENEL KARTLAR */
    .dash-grid {
        display: grid;
        gap: 18px;
    }

    .dash-stats {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-bottom: 26px;
    }

    .dash-card {
        background: #fff;
        border: 1px solid #e9eaf2;
        border-radius: 15px;
        padding: 21px;
        box-shadow: 0 4px 18px rgba(38, 48, 75, .035);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .dash-card:hover {
            box-shadow: 0 9px 24px rgba(38, 48, 75, .07);
        }

    /* İSTATİSTİK KARTLARI */
    .stat-card {
        position: relative;
        overflow: hidden;
        min-height: 145px;
    }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 85px;
            height: 85px;
            right: -35px;
            bottom: -40px;
            border-radius: 50%;
            background: var(--soft-color);
            opacity: .65;
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        z-index: 1;
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .stat-trend {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        background: #f8fafc;
        padding: 5px 8px;
        border-radius: 20px;
    }

    .stat-label {
        font-size: 12px;
        color: #7c8499;
        font-weight: 600;
        margin: 17px 0 3px;
    }

    .stat-value {
        font-size: 29px;
        font-weight: 800;
        color: #303954;
        margin: 0;
        line-height: 1.2;
    }

    .stat-sub {
        font-size: 11px;
        color: #9299aa;
        margin-top: 7px;
    }

    .stat-indigo {
        --soft-color: #8276D9;
    }

        .stat-indigo .stat-icon {
            background: #f0edff;
            color: #7568cc;
        }

    .stat-sky {
        --soft-color: #54a7d9;
    }

        .stat-sky .stat-icon {
            background: #eaf5fc;
            color: #3992c8;
        }

    .stat-amber {
        --soft-color: #e5aa50;
    }

        .stat-amber .stat-icon {
            background: #fff5e5;
            color: #d99a32;
        }

    .stat-green {
        --soft-color: #54b99b;
    }

        .stat-green .stat-icon {
            background: #e9f7f2;
            color: #43a789;
        }

    /* BÖLÜM BAŞLIKLARI */
    .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 19px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 750;
        color: #343B5C;
        margin: 0;
    }

    .section-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: #8276D9;
        font-size: 16px;
    }

    .section-link {
        color: #8276D9;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        white-space: nowrap;
    }

        .section-link:hover {
            color: #5548a9;
        }

    /* MESAJ TABLOSU */
    .message-table {
        margin: 0;
        min-width: 480px;
    }

        .message-table thead th {
            background: #f8f8fc;
            color: #8a90a2;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 12px 10px;
            border-bottom: 1px solid #ececf3;
        }

        .message-table tbody td {
            padding: 14px 10px;
            font-size: 12px;
            color: #555e75;
            border-bottom: 1px solid #f0f1f5;
        }

        .message-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .message-table tbody tr:hover {
            background: #fafaff;
        }

    .name-cell {
        display: flex;
        align-items: center;
        min-width: 140px;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 11px;
        background: #efedff;
        color: #7063c4;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 11px;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .sender-name {
        color: #343B5C;
        font-weight: 650;
        font-size: 12px;
    }

    .sender-email {
        font-size: 10px;
        color: #9ba1b0;
        margin-top: 3px;
    }

    .message-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-new {
        background: #fff3df;
        color: #c18424;
    }

    .status-read {
        background: #edf7f2;
        color: #399675;
    }

    .unread-row {
        background: #fcfbff;
    }

    /* PROJE LİSTESİ */
    .project-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px;
        border: 1px solid #eeeef4;
        border-radius: 11px;
        transition: .2s ease;
        background: #fff;
    }

        .project-item:hover {
            border-color: #d8d2fa;
            background: #fbfaff;
            transform: translateX(3px);
        }

    .project-image {
        width: 52px;
        height: 45px;
        border-radius: 9px;
        object-fit: cover;
        flex-shrink: 0;
        background: #f0eff8;
    }

    .project-placeholder {
        width: 52px;
        height: 45px;
        border-radius: 9px;
        background: #f0edff;
        color: #8276D9;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .project-title {
        color: #343B5C;
        font-size: 12px;
        font-weight: 700;
    }

    .project-category {
        color: #969caf;
        font-size: 10px;
        margin-top: 4px;
    }

    .project-badge {
        padding: 5px 8px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 650;
    }

    .project-active {
        background: #eaf7f1;
        color: #399675;
    }

    .project-passive {
        background: #f0f1f5;
        color: #858b9b;
    }

    /* KATEGORİLER */
    .category-area {
        border-top: 1px solid #eeeef4;
        margin-top: 20px;
        padding-top: 17px;
    }

    .category-title {
        font-size: 10px;
        color: #9298a9;
        font-weight: 750;
        letter-spacing: .6px;
        margin-bottom: 12px;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        background: #f7f6fc;
        color: #625b91;
        border: 1px solid #eeebfa;
        border-radius: 8px;
        font-size: 11px;
    }

    /* MESAJ ÖZETİ */
    .message-summary {
        background: #f8f7fd;
        border: 1px solid #eeebfa;
        border-radius: 11px;
        padding: 14px;
        margin-top: 18px;
    }

    .summary-heading {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        font-weight: 700;
        color: #535b76;
        margin-bottom: 10px;
    }

    .summary-track {
        height: 7px;
        display: flex;
        overflow: hidden;
        border-radius: 20px;
        background: #e9e7f3;
    }

    .summary-read {
        background: #50ae91;
        height: 100%;
    }

    .summary-unread {
        background: #e9ad55;
        height: 100%;
    }

    .summary-details {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 10px;
        font-size: 10px;
        color: #858ba0;
    }

    /* HIZLI MENÜ */
    .quick-card {
        margin-top: 24px;
    }

    .quick-links {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .quick-link-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border: 1px solid #ececf3;
        border-radius: 11px;
        color: #454e69;
        text-decoration: none;
        font-size: 12px;
        font-weight: 650;
        background: #fff;
        transition: .2s ease;
    }

        .quick-link-btn:hover {
            border-color: #cfc8f5;
            background: #faf9ff;
            color: #6659bb;
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(75, 65, 140, .07);
        }

    .quick-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f0edff;
        color: #8276D9;
        font-size: 17px;
        flex-shrink: 0;
    }

    /* BOŞ DURUM */
    .empty-state {
        padding: 35px 15px;
        text-align: center;
        color: #9ba1b0;
        font-size: 12px;
    }

        .empty-state i {
            display: block;
            font-size: 28px;
            color: #c5c0e8;
            margin-bottom: 10px;
        }

    /* RESPONSIVE */
    @@media (max-width: 1100px) {
        .dash-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .quick-links {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 576px) {
        .dash-welcome {
            padding: 23px 19px;
        }

            .dash-welcome h2 {
                font-size: 21px;
            }

        .dash-stats {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .dash-card {
            padding: 15px;
        }

        .stat-card {
            min-height: 135px;
        }

        .stat-value {
            font-size: 25px;
        }

        .stat-icon {
            width: 39px;
            height: 39px;
            font-size: 18px;
        }

        .quick-links {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .quick-link-btn {
            padding: 10px;
            gap: 8px;
            font-size: 11px;
        }

        .quick-icon {
            width: 31px;
            height: 31px;
            font-size: 15px;
        }

        .section-title {
            font-size: 13px;
        }
    }
</style>

<div class="dash">

    <!-- KARŞILAMA ALANI -->
    <div class="dash-welcome">
        <div class="welcome-content">
            <div class="welcome-label">
                <i class="bi bi-grid-1x2-fill"></i>
                YÖNETİM PANELİ
            </div>

            <h2>Kontrol Paneline Hoş Geldin</h2>

            <p>Portföyünü, projelerini ve gelen mesajlarını tek bir yerden yönetebilirsin.</p>

            <div class="welcome-actions">
                <a href="/Admin/Project/CreateProject" class="welcome-btn welcome-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Yeni Proje Ekle
                </a>

                <a href="/Default/Index" target="_blank" class="welcome-btn welcome-btn-outline">
                    <i class="bi bi-box-arrow-up-right"></i>
                    Web Sitesini Gör
                </a>
            </div>
        </div>
    </div>

    <!-- İSTATİSTİK KARTLARI -->
    <div class="dash-grid dash-stats">

        <div class="dash-card stat-card stat-indigo">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-grid-fill"></i>
                </div>
                <span class="stat-trend">Portföy</span>
            </div>

            <p class="stat-label">Toplam Proje</p>
            <p class="stat-value">@(Model?.TotalProjectCount ?? 0)</p>
            <div class="stat-sub">
                <i class="bi bi-check-circle-fill text-success me-1"></i>
                @(Model?.ActiveProjectCount ?? 0) aktif yayında
            </div>
        </div>

        <div class="dash-card stat-card stat-sky">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-code-slash"></i>
                </div>
                <span class="stat-trend">Teknik</span>
            </div>

            <p class="stat-label">Toplam Yetenek</p>
            <p class="stat-value">@(Model?.TotalSkillCount ?? 0)</p>
            <div class="stat-sub">
                <i class="bi bi-tags me-1"></i>
                @(Model?.CategoryCount ?? 0) farklı kategoride
            </div>
        </div>

        <div class="dash-card stat-card stat-amber">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <span class="stat-trend">Mesajlar</span>
            </div>

            <p class="stat-label">Okunmamış Mesaj</p>
            <p class="stat-value">@unreadMsg</p>
            <div class="stat-sub">
                <i class="bi bi-inbox me-1"></i>
                Toplam @totalMsg mesajdan
            </div>
        </div>

        <div class="dash-card stat-card stat-green">
            <div class="stat-top">
                <div class="stat-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <span class="stat-trend">Özgeçmiş</span>
            </div>

            <p class="stat-label">Eğitim & Deneyim</p>
            <p class="stat-value">
                @((Model?.EducationCount ?? 0) + (Model?.ExperienceCount ?? 0))
            </p>
            <div class="stat-sub">
                @(Model?.ExperienceCount ?? 0) Deneyim,
                @(Model?.EducationCount ?? 0) Eğitim
            </div>
        </div>

    </div>

    <!-- MESAJLAR VE PROJELER -->
    <div class="row g-4 mb-4">

        <!-- SON GELEN MESAJLAR -->
        <div class="col-lg-7">
            <div class="dash-card h-100">

                <div class="section-heading">
                    <h5 class="section-title">
                        <span class="section-icon">
                            <i class="bi bi-envelope-open"></i>
                        </span>
                        Son Gelen Mesajlar
                    </h5>

                    <a href="/Admin/Message/MessageList" class="section-link">
                        Tümünü Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (Model?.LatestMessages != null && Model.LatestMessages.Any())
                {
                    <div class="table-responsive">
                        <table class="table message-table align-middle">
                            <thead>
                                <tr>
                                    <th>Gönderen</th>
                                    <th>Konu</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var msg in Model.LatestMessages)
                                {
                                    var initials = !string.IsNullOrWhiteSpace(msg.NameSurname)
                                        ? string.Join("", msg.NameSurname
                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                            .Take(2)
                                            .Select(x => x.Substring(0, 1).ToUpper()))
                                        : "MS";

                                    <tr class="@(!msg.IsRead ? "unread-row" : "")">
                                        <td>
                                            <div class="name-cell">
                                                <span class="avatar">@initials</span>
                                                <div class="overflow-hidden">
                                                    <div class="sender-name text-truncate"
                                                         style="max-width: 140px;">
                                                        @msg.NameSurname
                                                    </div>
                                                    <div class="sender-email text-truncate"
                                                         style="max-width: 140px;">
                                                        @msg.Email
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="text-truncate d-inline-block"
                                                  style="max-width: 150px; font-size: 12px;">
                                                @msg.Subject
                                            </span>
                                        </td>

                                        <td class="text-nowrap">
                                            @msg.SendDate.ToString("dd MMM")
                                        </td>

                                        <td>
                                            @if (!msg.IsRead)
                                            {
                                                <span class="message-status status-new">
                                                    <i class="bi bi-circle-fill" style="font-size:6px;"></i>
                                                    Yeni
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="message-status status-read">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Okundu
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- MESAJ OKUNMA ÖZETİ -->
                    <div class="message-summary">
                        <div class="summary-heading">
                            <span>Mesaj Durumu</span>
                            <span>@readPercent% Okundu</span>
                        </div>

                        <div class="summary-track">
                            <div class="summary-read" style="width: @readPercent%"></div>
                            <div class="summary-unread" style="width: @unreadPercent%"></div>
                        </div>

                        <div class="summary-details">
                            <span>
                                <i class="bi bi-circle-fill text-success me-1"></i>
                                @readMsg Okunmuş
                            </span>
                            <span>
                                <i class="bi bi-circle-fill text-warning me-1"></i>
                                @unreadMsg Okunmamış
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        Henüz gelen bir mesaj bulunmuyor.
                    </div>
                }

            </div>
        </div>

        <!-- SON EKLENEN PROJELER -->
        <div class="col-lg-5">
            <div class="dash-card h-100">

                <div class="section-heading">
                    <h5 class="section-title">
                        <span class="section-icon">
                            <i class="bi bi-folder-check"></i>
                        </span>
                        Son Eklenen Projeler
                    </h5>

                    <a href="/Admin/Project/ProjectList" class="section-link">
                        Tümünü Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (Model?.LatestProjects != null && Model.LatestProjects.Any())
                {
                    <div class="d-flex flex-column gap-2">

                        @foreach (var proj in Model.LatestProjects)
                        {
                            <div class="project-item">

                                @if (!string.IsNullOrEmpty(proj.CoverImageUrl))
                                {
                                    <img src="@proj.CoverImageUrl"
                                         alt="@proj.Title"
                                         class="project-image" />
                                }
                                else
                                {
                                    <div class="project-placeholder">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }

                                <div class="overflow-hidden flex-grow-1">
                                    <div class="project-title text-truncate">
                                        @proj.Title
                                    </div>

                                    <div class="project-category">
                                        @(proj.Category?.CategoryName ?? "Genel")
                                    </div>
                                </div>

                                <div>
                                    @if (proj.IsActive)
                                    {
                                        <span class="project-badge project-active">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="project-badge project-passive">
                                            Pasif
                                        </span>
                                    }
                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-folder2-open"></i>
                        Henüz eklenmiş proje bulunmuyor.
                    </div>
                }

                <!-- KATEGORİ DAĞILIMI -->
                @if (Model?.CategoryProjectCounts != null && Model.CategoryProjectCounts.Any())
                {
                    <div class="category-area">
                        <div class="category-title">
                            <i class="bi bi-pie-chart-fill me-1"></i>
                            KATEGORİ PROJE DAĞILIMI
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cat in Model.CategoryProjectCounts)
                            {
                                <span class="category-badge">
                                    <i class="bi bi-tag-fill"></i>
                                    @cat.Key
                                    <strong>@cat.Value</strong>
                                </span>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>

    <!-- HIZLI YÖNETİM MENÜSÜ -->
    <div class="dash-card quick-card">

        <div class="section-heading">
            <h5 class="section-title">
                <span class="section-icon">
                    <i class="bi bi-lightning-charge-fill"></i>
                </span>
                Hızlı Yönetim Menüsü
            </h5>
        </div>

        <div class="quick-links">

            <a href="/Admin/Project/ProjectList" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-grid-fill"></i></span>
                Projeler
            </a>

            <a href="/Admin/Category/CategoryList" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-tags-fill"></i></span>
                Kategoriler
            </a>

            <a href="/Admin/Skill/SkillList" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-code-slash"></i></span>
                Yetenekler
            </a>

            <a href="/Admin/Experience/ExperienceList" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-briefcase-fill"></i></span>
                Deneyimler
            </a>

            <a href="/Admin/Education" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-mortarboard-fill"></i></span>
                Eğitim
            </a>

            <a href="/Admin/About" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-person-fill"></i></span>
                Hakkımda
            </a>

            <a href="/Admin/Message/MessageList" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-envelope-fill"></i></span>
                Mesajlar
            </a>

            <a href="/Admin/Setting/Index" class="quick-link-btn">
                <span class="quick-icon"><i class="bi bi-gear-fill"></i></span>
                Ayarlar & CV
            </a>

        </div>
    </div>

</div>
