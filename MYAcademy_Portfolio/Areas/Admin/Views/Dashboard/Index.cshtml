@model MYAcademy_Portfolio.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int totalMsg = Model?.TotalMessageCount ?? 0;
    int readMsg = Model?.ReadMessageCount ?? 0;
    int unreadMsg = Model?.UnreadMessageCount ?? 0;
    int readPercent = totalMsg > 0 ? (int)Math.Round(readMsg * 100.0 / totalMsg) : 0;
    int unreadPercent = totalMsg > 0 ? 100 - readPercent : 0;
}

<style>
    .dash { font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; color: #1f2937; padding: 4px 0 24px; }
    .dash-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
    .dash-header h2 { font-size: 24px; font-weight: 700; margin: 0; color: #1e293b; }
    .dash-header p { margin: 4px 0 0; color: #64748b; font-size: 14px; }

    .dash-grid { display: grid; gap: 20px; }
    .dash-stats { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px; }
    .dash-main { grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); margin-bottom: 24px; }

    .dash-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 22px; box-shadow: 0 4px 15px rgba(0,0,0,.03); }
    .dash-card h5 { font-size: 16px; font-weight: 600; margin: 0 0 18px; display: flex; justify-content: space-between; align-items: center; color: #1e293b; }
    .dash-card h5 a { font-size: 13px; font-weight: 500; color: #6366f1; text-decoration: none; }

    .stat-card { display: flex; align-items: center; gap: 16px; }
    .stat-icon { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; }
    .stat-label { font-size: 13px; color: #64748b; margin: 0; font-weight: 500; }
    .stat-value { font-size: 28px; font-weight: 800; margin: 2px 0 0; line-height: 1.1; color: #0f172a; }
    .stat-sub { font-size: 12px; color: #94a3b8; margin-top: 4px; }

    .bg-indigo { background: #eef2ff; color: #6366f1; }
    .bg-green { background: #ecfdf5; color: #10b981; }
    .bg-amber { background: #fffbeb; color: #f59e0b; }
    .bg-sky { background: #f0f9ff; color: #0284c7; }
    .bg-purple { background: #f5f3ff; color: #8b5cf6; }

    .avatar { width: 36px; height: 36px; border-radius: 50%; background: #e0e7ff; color: #4338ca; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; margin-right: 12px; flex-shrink: 0; }
    .name-cell { display: flex; align-items: center; }

    .quick-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }
    .quick-link-btn { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid #e2e8f0; border-radius: 10px; color: #334155; text-decoration: none; font-size: 13px; font-weight: 600; background: #f8fafc; transition: all .2s ease; }
    .quick-link-btn:hover { border-color: #6366f1; background: #eef2ff; color: #4338ca; transform: translateY(-2px); }
</style>

<div class="dash">

    <!-- Başlık ve Hızlı Eylem -->
    <div class="dash-header">
       
        <div class="d-flex gap-2">
            <a href="/Admin/Project/CreateProject" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Yeni Proje Ekle
            </a>
            <a href="/Default/Index" target="_blank" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-arrow-up-right me-1"></i> Siteyi Gör
            </a>
        </div>
    </div>

    <!-- 4 Ana İstatistik Kartı -->
    <div class="dash-grid dash-stats">
        <!-- Projeler -->
        <div class="dash-card stat-card">
            <div class="stat-icon bg-indigo">
                <i class="bi bi-grid-fill"></i>
            </div>
            <div>
                <p class="stat-label">Toplam Proje</p>
                <p class="stat-value">@(Model?.TotalProjectCount ?? 0)</p>
                <div class="stat-sub text-success">
                    <i class="bi bi-check-circle-fill me-1"></i> @(Model?.ActiveProjectCount ?? 0) aktif yayında
                </div>
            </div>
        </div>

        <!-- Yetenekler -->
        <div class="dash-card stat-card">
            <div class="stat-icon bg-sky">
                <i class="bi bi-code-slash"></i>
            </div>
            <div>
                <p class="stat-label">Toplam Yetenek</p>
                <p class="stat-value">@(Model?.TotalSkillCount ?? 0)</p>
                <div class="stat-sub">@(Model?.CategoryCount ?? 0) farklı kategoride</div>
            </div>
        </div>

        <!-- Okunmamış Mesajlar -->
        <div class="dash-card stat-card">
            <div class="stat-icon bg-amber">
                <i class="bi bi-envelope-fill"></i>
            </div>
            <div>
                <p class="stat-label">Okunmamış Mesaj</p>
                <p class="stat-value">@unreadMsg</p>
                <div class="stat-sub text-warning">
                    Toplam @totalMsg mesajdan
                </div>
            </div>
        </div>

        <!-- Deneyim & Eğitim -->
        <div class="dash-card stat-card">
            <div class="stat-icon bg-green">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <p class="stat-label">Eğitim & Deneyim</p>
                <p class="stat-value">@((Model?.EducationCount ?? 0) + (Model?.ExperienceCount ?? 0))</p>
                <div class="stat-sub">
                    @(Model?.ExperienceCount ?? 0) Deneyim, @(Model?.EducationCount ?? 0) Eğitim
                </div>
            </div>
        </div>
    </div>

    <!-- İki Kolonlu Orta Bölüm: Son Mesajlar & Projeler -->
    <div class="row g-4 mb-4">
        <!-- Son Gelen 5 Mesaj Tablosu -->
        <div class="col-lg-7">
            <div class="dash-card h-100">
                <h5>
                    <span><i class="bi bi-envelope-open me-2 text-primary"></i>Son Gelen Mesajlar</span>
                    <a href="/Admin/Message/MessageList">Tümünü Gör →</a>
                </h5>

                @if (Model?.LatestMessages != null && Model.LatestMessages.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Gönderen</th>
                                    <th>Konu</th>
                                    <th>Tarih</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in Model.LatestMessages)
                                {
                                    var initials = !string.IsNullOrWhiteSpace(msg.NameSurname) && msg.NameSurname.Length >= 2
                                        ? msg.NameSurname.Substring(0, 2).ToUpper()
                                        : "MS";

                                    <tr class="@(!msg.IsRead ? "fw-bold" : "")">
                                        <td>
                                            <div class="name-cell">
                                                <span class="avatar">@initials</span>
                                                <div class="overflow-hidden">
                                                    <div class="text-truncate" style="max-width: 140px;">@msg.NameSurname</div>
                                                    <small class="text-muted d-block text-truncate" style="max-width: 140px;">@msg.Email</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 180px;">@msg.Subject</span>
                                        </td>
                                        <td class="text-muted small">@msg.SendDate.ToString("dd MMM")</td>
                                        <td>
                                            @if (!msg.IsRead)
                                            {
                                                <span class="badge bg-warning text-dark">Yeni</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Okundu</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                        Henüz gelen bir mesaj bulunmuyor.
                    </div>
                }
            </div>
        </div>

        <!-- Son Eklenen Projeler & Kategori Dağılımı -->
        <div class="col-lg-5">
            <div class="dash-card h-100">
                <h5>
                    <span><i class="bi bi-folder-check me-2 text-indigo"></i>Son Eklenen Projeler</span>
                    <a href="/Admin/Project/ProjectList">Tümünü Gör →</a>
                </h5>

                @if (Model?.LatestProjects != null && Model.LatestProjects.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var proj in Model.LatestProjects)
                        {
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 border bg-light">
                                @if (!string.IsNullOrEmpty(proj.CoverImageUrl))
                                {
                                    <img src="@proj.CoverImageUrl"
                                         alt="@proj.Title"
                                         class="rounded-2 shadow-sm"
                                         style="width: 50px; height: 40px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-2 bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center"
                                         style="width: 50px; height: 40px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                                <div class="overflow-hidden flex-grow-1">
                                    <div class="fw-semibold text-dark text-truncate" style="font-size: 0.9rem;">@proj.Title</div>
                                    <small class="text-muted">@(proj.Category?.CategoryName ?? "Genel")</small>
                                </div>
                                <div>
                                    @if (proj.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        Henüz eklenmiş proje bulunmuyor.
                    </div>
                }

                <!-- Kategori Dağılımı Özeti -->
                @if (Model?.CategoryProjectCounts != null && Model.CategoryProjectCounts.Any())
                {
                    <div class="mt-4 pt-3 border-top">
                        <small class="fw-bold text-muted d-block mb-2">KATEGORİ PROJE DAĞILIMI</small>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var cat in Model.CategoryProjectCounts)
                            {
                                <span class="badge bg-light text-dark border p-2">
                                    <i class="bi bi-tag-fill me-1 text-primary"></i> @cat.Key: <strong>@cat.Value</strong>
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Hızlı Erişim Butonları -->
    <div class="dash-card">
        <h5 class="mb-3">
            <span><i class="bi bi-lightning-charge me-2 text-warning"></i>Hızlı Yönetim Menüsü</span>
        </h5>
        <div class="quick-links">
            <a href="/Admin/Project/ProjectList" class="quick-link-btn">
                <i class="bi bi-grid text-primary fs-5"></i> Projeler
            </a>
            <a href="/Admin/Category/CategoryList" class="quick-link-btn">
                <i class="bi bi-tags text-success fs-5"></i> Kategoriler
            </a>
            <a href="/Admin/Skill/SkillList" class="quick-link-btn">
                <i class="bi bi-code-slash text-info fs-5"></i> Yetenekler
            </a>
            <a href="/Admin/Experience/ExperienceList" class="quick-link-btn">
                <i class="bi bi-briefcase text-warning fs-5"></i> Deneyimler
            </a>
            <a href="/Admin/Education" class="quick-link-btn">
                <i class="bi bi-mortarboard text-danger fs-5"></i> Eğitim
            </a>
            <a href="/Admin/About" class="quick-link-btn">
                <i class="bi bi-person text-secondary fs-5"></i> Hakkımda
            </a>
            <a href="/Admin/Message/MessageList" class="quick-link-btn">
                <i class="bi bi-envelope text-indigo fs-5"></i> Mesajlar
            </a>
            <a href="/Admin/Setting/Index" class="quick-link-btn">
                <i class="bi bi-gear text-dark fs-5"></i> Ayarlar & CV
            </a>
        </div>
    </div>

</div>
