@model MYAcademy_Portfolio.Entities.Category

@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h3>Kategori Düzenle</h3>
        <p class="text-muted">Kategori bilgilerini güncelleyin.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditCategory"
                  asp-route-id="@Model.CategoryId"
                  method="post">

                <input type="hidden" asp-for="CategoryId" />

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label">
                        Kategori Adı
                    </label>

                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="Kategori adını giriniz" />

                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Güncelle
                    </button>

                    <a asp-action="CategoryList" class="btn btn-secondary">
                        Vazgeç
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
