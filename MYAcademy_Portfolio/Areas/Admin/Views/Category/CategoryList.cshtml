@model List<MYAcademy_Portfolio.Entities.Category>

@{
    ViewData["Title"] = "Kategori Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
      

        <a href="/Admin/Category/CreateCategory" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Kategori Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kategori Adı</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.CategoryId</td>
                                    <td>
                                        <strong>@item.CategoryName</strong>
                                    </td>
                                    <td class="text-end">
                                        <a href="/Admin/Category/EditCategory/@item.CategoryId"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>

                                        <form asp-action="DeleteCategory"
                                              asp-route-id="@item.CategoryId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">

                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">
                                    Henüz kategori eklenmemiş.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
