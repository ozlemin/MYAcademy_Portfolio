@model List<MYAcademy_Portfolio.Entities.Project>

@{
    ViewData["Title"] = "Proje Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
      

        <a asp-action="CreateProject" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Proje Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Görsel</th>
                            <th>Proje Adı</th>
                            <th>Kategori</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                        {
                                            <img src="@item.CoverImageUrl"
                                                 alt="@item.Title"
                                                 style="width:75px;height:55px;object-fit:cover;border-radius:6px;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">Görsel yok</span>
                                        }
                                    </td>

                                    <td>
                                        <strong>@item.Title</strong>
                                    </td>

                                    <td>
                                        @(item.Category?.CategoryName ?? "Kategori yok")
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="UpdateProject"
                                           asp-route-id="@item.ProjectId"
                                           class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>

                                        <form asp-action="DeleteProject"
                                              asp-route-id="@item.ProjectId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz?');">

                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    Henüz proje eklenmemiş.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>
