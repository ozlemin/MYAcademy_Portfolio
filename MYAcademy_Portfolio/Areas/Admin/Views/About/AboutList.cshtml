@model List<MYAcademy_Portfolio.Entities.About>

@{
    ViewData["Title"] = "Hakkımda Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@section Styles {
    <style>
        .about-page {
            --primary: #5558A6;
            --purple: #8276D9;
            --dark: #343B5C;
            --muted: #8990A8;
            --border: #EAECF2;
        }

            .about-page .page-heading {
                color: var(--dark);
                font-weight: 750;
                font-size: 21px;
            }

            .about-page .page-description {
                color: var(--muted);
                font-size: 13px;
            }

            .about-page .list-card {
                background: #fff;
                border: 1px solid var(--border);
                border-radius: 16px;
                box-shadow: 0 4px 20px rgba(52,59,92,.045);
                overflow: hidden;
            }

            .about-page .list-card-header {
                padding: 21px 24px;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 15px;
            }

            .about-page .header-icon {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                background: #F1F0FC;
                color: var(--primary);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
            }

            .about-page .header-title {
                color: var(--dark);
                font-size: 15px;
                font-weight: 750;
                margin-bottom: 4px;
            }

            .about-page .header-subtitle {
                color: var(--muted);
                font-size: 11px;
                margin: 0;
            }

            .about-page .count-badge {
                background: #F1F0FC;
                color: var(--primary);
                padding: 8px 13px;
                border-radius: 30px;
                font-size: 11px;
                font-weight: 700;
            }

            .about-page .btn-add {
                background: linear-gradient(135deg, #5558A6, #8276D9);
                border: none;
                color: #fff;
                border-radius: 9px;
                padding: 10px 16px;
                font-size: 12px;
                font-weight: 650;
                transition: .2s;
            }

                .about-page .btn-add:hover {
                    color: #fff;
                    transform: translateY(-2px);
                    box-shadow: 0 5px 14px rgba(85,88,166,.2);
                }

            .about-page .table {
                margin: 0;
                white-space: nowrap;
            }

                .about-page .table thead th {
                    background: #F8F9FC;
                    color: #777F99;
                    font-size: 10px;
                    font-weight: 750;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                    padding: 15px 17px;
                    border-bottom: 1px solid var(--border);
                    border-top: none;
                }

                .about-page .table tbody td {
                    padding: 16px 17px;
                    border-color: #F0F1F5;
                    color: #555D76;
                    font-size: 12px;
                    vertical-align: middle;
                }

                .about-page .table tbody tr {
                    transition: background .2s ease;
                }

                    .about-page .table tbody tr:hover {
                        background: #FAFAFE;
                    }

            .about-page .id-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 30px;
                height: 30px;
                border-radius: 9px;
                background: #F1F0FC;
                color: var(--primary);
                font-weight: 750;
                font-size: 11px;
            }

            .about-page .person-cell {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .about-page .person-avatar {
                width: 36px;
                height: 36px;
                flex-shrink: 0;
                border-radius: 11px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #5558A6, #8276D9);
                color: white;
                font-weight: 750;
                font-size: 11px;
            }

            .about-page .person-name {
                color: var(--dark);
                font-weight: 700;
                font-size: 12px;
            }

            .about-page .job-badge {
                background: #F1F0FC;
                color: var(--primary);
                padding: 6px 10px;
                border-radius: 7px;
                font-size: 10px;
                font-weight: 650;
            }

            .about-page .email-cell {
                color: #69718A;
                font-size: 11px;
            }

            .about-page .action-buttons {
                display: flex;
                align-items: center;
                gap: 7px;
            }

            .about-page .btn-action {
                width: 33px;
                height: 33px;
                border-radius: 9px;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                border: 1px solid transparent;
                font-size: 14px;
                transition: .2s;
            }

            .about-page .btn-edit {
                background: #F1F0FC;
                color: #625AB3;
                border-color: #E7E4FA;
            }

                .about-page .btn-edit:hover {
                    background: var(--primary);
                    color: white;
                }

            .about-page .btn-delete {
                background: #FFF1F1;
                color: #D65B64;
                border-color: #F8DEDF;
            }

                .about-page .btn-delete:hover {
                    background: #D65B64;
                    color: white;
                }

            .about-page .empty-state {
                padding: 65px 20px;
                text-align: center;
            }

            .about-page .empty-icon {
                width: 65px;
                height: 65px;
                border-radius: 20px;
                background: #F1F0FC;
                color: var(--purple);
                font-size: 27px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 18px;
            }

            .about-page .empty-title {
                color: var(--dark);
                font-weight: 750;
                font-size: 15px;
            }

            .about-page .empty-description {
                color: var(--muted);
                font-size: 12px;
                margin-bottom: 20px;
            }

        @@media(max-width: 767px) {
            .about-page .list-card-header {
                padding: 17px;
            }

            .about-page .page-heading {
                font-size: 18px;
            }

            .about-page .table thead th,
            .about-page .table tbody td {
                padding: 13px;
            }
        }
    </style>
}

<div class="container-fluid about-page">

    <!-- SAYFA BAŞLIĞI -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">


        @if (!Model.Any())
        {
            <a asp-action="CreateAbout" class="btn btn-add">
                <i class="bi bi-plus-lg me-1"></i>
                Hakkımda Bilgisi Ekle
            </a>
        }

    </div>

    <!-- LİSTE KARTI -->
    <div class="list-card">

        <div class="list-card-header">

            <div class="d-flex align-items-center gap-3">
                <div class="header-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

            </div>

            <div class="d-flex align-items-center gap-3">
                <span class="count-badge">
                    <i class="bi bi-database me-1"></i>
                    @Model.Count() Kayıt
                </span>

                @if (Model.Any())
                {
                    <a asp-action="CreateAbout" class="btn btn-add">
                        <i class="bi bi-plus-lg me-1"></i>
                        Yeni Kayıt
                    </a>
                }
            </div>

        </div>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ad Soyad</th>
                            <th>Unvan</th>
                            <th>Konum</th>
                            <th>Uzmanlık</th>
                            <th>E-posta</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var initials = !string.IsNullOrWhiteSpace(item.NameSurname)
                                ? string.Join("", item.NameSurname.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(x => x[0])).ToUpper()
                                : "ÖB";

                            <tr>

                                <td>
                                    <span class="id-badge">@item.AboutId</span>
                                </td>

                                <td>
                                    <div class="person-cell">
                                        <div class="person-avatar">
                                            @initials
                                        </div>
                                        <span class="person-name">
                                            @item.NameSurname
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="job-badge">
                                        @item.JobTitle
                                    </span>
                                </td>

                                <td>
                                    <i class="bi bi-geo-alt me-1 text-muted"></i>
                                    @item.Location
                                </td>

                                <td>
                                    @item.Expert
                                </td>

                                <td>
                                    <span class="email-cell">
                                        <i class="bi bi-envelope me-1"></i>
                                        @item.Email
                                    </span>
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="EditAbout"
                                           asp-route-id="@item.AboutId"
                                           class="btn-action btn-edit"
                                           title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="DeleteAbout"
                                              asp-route-id="@item.AboutId"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Hakkımda bilgilerini silmek istediğinize emin misiniz?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-action btn-delete"
                                                    title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-person-plus"></i>
                </div>

                <h6 class="empty-title">
                    Henüz profil bilgisi eklenmemiş
                </h6>

                <p class="empty-description">
                    Portföyünüzde Hakkımda bölümünü oluşturmak için ilk profil kaydınızı ekleyebilirsiniz.
                </p>

                <a asp-action="CreateAbout" class="btn btn-add">
                    <i class="bi bi-plus-lg me-1"></i>
                    İlk Profil Kaydını Oluştur
                </a>

            </div>
        }

    </div>

</div>
