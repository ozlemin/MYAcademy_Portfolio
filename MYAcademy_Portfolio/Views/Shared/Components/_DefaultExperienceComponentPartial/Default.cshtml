@model List<MYAcademy_Portfolio.Entities.Experience>

<!-- Work Experience Section -->
<section id="experience">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">PROFESYONEL YOLCULUK</span>
            <h2 class="section-title">Deneyimlerim</h2>
            <p class="section-subtitle">Gerçek dünya problemlerini çözerken edindiğim tecrübeler.</p>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-4 text-secondary">
                <i class="bi bi-briefcase fs-2 d-block mb-2"></i>
                <p class="mb-0">Henüz aktif deneyim bilgisi eklenmemiştir.</p>
            </div>
        }
        else
        {
            <div class="timeline-container">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    var isEven = i % 2 == 0;
                    var badgeColor = (i % 3 == 0) ? "bg-icon-purple" : (i % 3 == 1 ? "bg-icon-blue" : "bg-icon-peach");

                    <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                        @if (isEven)
                        {
                            <div class="col-lg-6 timeline-left order-2 order-lg-1">
                                <div class="timeline-content-card">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge-year @badgeColor">
                                            <i class="bi bi-briefcase"></i> @item.Duration
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.WorkType))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">@item.WorkType</span>
                                        }
                                    </div>
                                    <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                    <div class="text-primary fw-semibold small mb-3">@item.CompanyName</div>
                                    <p class="text-secondary small mb-3" style="line-height: 1.6;">
                                        @item.Description
                                    </p>
                                    @if (!string.IsNullOrEmpty(item.SideTitle))
                                    {
                                        <div>
                                            <span class="tech-tag">@item.SideTitle</span>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="timeline-marker">
                                <i class="bi bi-building"></i>
                            </div>
                            <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                                <div class="text-secondary small fst-italic">@item.CompanyName</div>
                            </div>
                        }
                        else
                        {
                            <div class="col-lg-6 timeline-left d-none d-lg-block">
                                <div class="text-secondary small fst-italic text-end">@item.CompanyName</div>
                            </div>
                            <div class="timeline-marker">
                                <i class="bi bi-pc-display"></i>
                            </div>
                            <div class="col-lg-6 timeline-right">
                                <div class="timeline-content-card">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge-year @badgeColor">
                                            <i class="bi bi-briefcase"></i> @item.Duration
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.WorkType))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">@item.WorkType</span>
                                        }
                                    </div>
                                    <h4 class="fs-5 fw-bold mb-1">@item.Title</h4>
                                    <div class="text-primary fw-semibold small mb-3">@item.CompanyName</div>
                                    <p class="text-secondary small mb-3" style="line-height: 1.6;">
                                        @item.Description
                                    </p>
                                    @if (!string.IsNullOrEmpty(item.SideTitle))
                                    {
                                        <div>
                                            <span class="tech-tag">@item.SideTitle</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
