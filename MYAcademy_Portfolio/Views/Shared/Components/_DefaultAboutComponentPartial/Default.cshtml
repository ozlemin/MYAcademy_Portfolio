
@model MYAcademy_Portfolio.Entities.About

<section id="about">
    <div class="container">

        <!-- Başlık -->
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">BENİ TANIYIN</span>
            <h2 class="section-title">Hakkımda</h2>
            <p class="section-subtitle">
                Yazılım geliştirme alanında öğrenmeye, üretmeye ve kendimi geliştirmeye devam ediyorum.
            </p>
        </div>

        @if (Model == null || string.IsNullOrWhiteSpace(Model.NameSurname))
        {
            <p class="portfolio-empty text-center">
                Profil bilgileri yakında eklenecek.
            </p>
        }
        else
        {
            <div class="row g-5 align-items-center">

                <!-- Sol: Kişisel Bilgiler -->
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="about-visual-box">

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="float-icon-box bg-icon-purple"
                                 style="width: 52px; height: 52px; font-size: 1.4rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>

                            <div>
                                <h4 class="mb-0 fs-5 fw-bold">
                                    @Model.NameSurname
                                </h4>
                                <span class="text-secondary small">
                                    @Model.JobTitle
                                </span>
                            </div>
                        </div>

                        <div class="info-list">

                            <div class="info-list-item">
                                <span class="info-label">
                                    <i class="bi bi-person me-2"></i>Ad Soyad
                                </span>
                                <span class="info-value">
                                    @Model.NameSurname
                                </span>
                            </div>

                            <div class="info-list-item">
                                <span class="info-label">
                                    <i class="bi bi-briefcase me-2"></i>Meslek
                                </span>
                                <span class="info-value">
                                    @Model.JobTitle
                                </span>
                            </div>

                            <div class="info-list-item">
                                <span class="info-label">
                                    <i class="bi bi-geo-alt me-2"></i>Konum
                                </span>
                                <span class="info-value">
                                    @Model.Location
                                </span>
                            </div>

                            <div class="info-list-item">
                                <span class="info-label">
                                    <i class="bi bi-layers me-2"></i>Uzmanlık
                                </span>
                                <span class="info-value">
                                    @Model.Expert
                                </span>
                            </div>

                            <div class="info-list-item">
                                <span class="info-label">
                                    <i class="bi bi-envelope me-2"></i>E-posta
                                </span>
                                <span class="info-value">
                                    @Model.Email
                                </span>
                            </div>

                        </div>

                        <!-- İş Fırsatları -->
                        @if (!string.IsNullOrWhiteSpace(Model.OpenToWork))
                        {
                            <div class="mt-4 pt-2">
                                <div class="p-3 rounded-4"
                                     style="background-color: var(--lavender-accent);">

                                    <div class="d-flex align-items-center gap-2 text-dark small fw-semibold">
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                        @Model.OpenToWork
                                    </div>

                                </div>
                            </div>
                        }

                    </div>
                </div>

                <!-- Sağ: Hakkımda ve Açıklama -->
                <div class="col-lg-7 reveal-on-scroll">
                    <div class="pe-lg-3">

                        <h4 class="fs-5 fw-bold mb-3">Kısaca Ben</h4>

                        <p class="fs-6 text-secondary mb-4">
                            @Model.Description
                        </p>

                        <!-- Özellik Kartları -->
                        <div class="row g-3">

                            <div class="col-md-4">
                                <div class="highlight-card">
                                    <div class="float-icon-box bg-icon-purple mb-3">
                                        <i class="bi bi-code-slash"></i>
                                    </div>

                                    <h5 class="fs-6 fw-bold mb-1">
                                        Web Geliştirme
                                    </h5>

                                    <p class="text-secondary small mb-0">
                                        C# ve ASP.NET Core MVC ile web uygulamaları geliştirme.
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="highlight-card">
                                    <div class="float-icon-box bg-icon-mint mb-3">
                                        <i class="bi bi-database"></i>
                                    </div>

                                    <h5 class="fs-6 fw-bold mb-1">
                                        Veritabanı
                                    </h5>

                                    <p class="text-secondary small mb-0">
                                        Entity Framework Core ve SQL Server ile veri yönetimi.
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="highlight-card">
                                    <div class="float-icon-box bg-icon-blue mb-3">
                                        <i class="bi bi-lightbulb"></i>
                                    </div>

                                    <h5 class="fs-6 fw-bold mb-1">
                                        Sürekli Gelişim
                                    </h5>

                                    <p class="text-secondary small mb-0">
                                        Araştırarak ve proje geliştirerek yeni beceriler kazanma.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        }

    </div>
</section>
