@{
    Layout = null;
} 
<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body data-bs-spy="scroll" data-bs-target="#mainNavbar" data-bs-offset="100">

    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")
    
    <!-- Infinite Soft Marquee -->
    <div class="marquee-container">
        <div class="marquee-track">
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> C# .NET</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> ASP.NET Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Microsoft SQL Server</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Entity Framework Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> RESTful API Design</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Clean Architecture</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Bootstrap 5</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Docker & Git</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> C# .NET</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> ASP.NET Core</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Microsoft SQL Server</div>
            <div class="marquee-item"><i class="bi bi-check2-circle"></i> Entity Framework Core</div>
        </div>
    </div>

    <!-- About Section -->
    @await Component.InvokeAsync("_DefaultAboutComponentPartial")
   
    <!-- Education Section -->
    @await Component.InvokeAsync("_DefaultEducationComponentPartial")

    <!-- Work Experience Section -->
    @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

    <!-- Technical Skills Section -->
    @await Component.InvokeAsync("_DefaultSkillComponentPartial")

    <!-- Projects Section -->
    @await Component.InvokeAsync("_DefaultProjectComponentPartial")

    <!-- Contact Section -->
    <section id="contact" style="background-color: var(--bg-secondary);">
        <div class="container">
            <div class="text-center mb-5 reveal-on-scroll">
                <span class="section-eyebrow">İLETİŞİME GEÇELİM</span>
                <h2 class="section-title">Birlikte Harika İşler Üretebiliriz.</h2>
                <p class="section-subtitle">Yeni projeler veya iş birlikleri için benimle iletişime geçebilirsiniz.</p>
            </div>

            <div class="row g-5">
                <!-- Left: Contact Details -->
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="contact-info-card">
                        <h4 class="fs-4 fw-bold mb-3">İletişim Bilgileri</h4>
                        <p class="text-secondary mb-4">
                            Aşağıdaki iletişim kanalları üzerinden doğrudan bana ulaşabilir veya formu doldurarak mesaj bırakabilirsiniz.
                        </p>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-purple">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">E-posta</div>
                                <span class="fw-bold text-dark">iletisim@@example.com</span>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-blue">
                                <i class="bi bi-geo-alt"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">Konum</div>
                                <div class="fw-bold text-dark">İstanbul, Türkiye</div>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-mint">
                                <i class="bi bi-linkedin"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">LinkedIn</div>
                                <a href="https://linkedin.com" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">linkedin.com/in/profil</a>
                            </div>
                        </div>

                        <div class="contact-item">
                            <div class="contact-icon bg-icon-peach">
                                <i class="bi bi-github"></i>
                            </div>
                            <div>
                                <div class="text-secondary small fw-medium">GitHub</div>
                                <a href="https://github.com" target="_blank" rel="noopener" class="text-decoration-none fw-bold text-dark">github.com/profil</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Contact Form -->
                <div class="col-lg-7 reveal-on-scroll">
                    <div class="contact-form-card">
                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            </div>
                        }

                        <form method="post" action="/Default/SendMessage">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Adınız Soyadınız *</label>
                                    <input type="text" class="form-control" name="NameSurname" placeholder="Örn: Ahmet Yılmaz" required>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">E-posta Adresiniz *</label>
                                    <input type="email" class="form-control" name="Email" placeholder="Örn: ahmet@@example.com" required>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Konu *</label>
                                    <input type="text" class="form-control" name="Subject" placeholder="Örn: Proje İş Birliği" required>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Mesajınız *</label>
                                    <textarea class="form-control" name="MessageDetail" rows="5" placeholder="Mesajınızı buraya yazınız..." required></textarea>
                                </div>

                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                                        <i class="bi bi-send-fill"></i> Mesaj Gönder
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center py-4">
            <p class="text-secondary small mb-0">© @DateTime.Now.Year Poyraz Alsever. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <!-- Scroll To Top Button -->
    <button id="scrollToTopBtn" class="scroll-to-top" aria-label="Sayfanın Başına Çık">
        <i class="bi bi-chevron-up"></i>
    </button>

    <!-- Bootstrap & Site Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>
